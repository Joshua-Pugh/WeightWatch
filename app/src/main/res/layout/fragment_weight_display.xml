<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".activity.WeightDisplayScreen">

    <TextView
        android:id="@+id/tvWeightByDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="cursive"
        android:letterSpacing="0.05"
        android:text="@string/daily_weight_by_date"
        android:textColor="@color/orange"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- GridView for displaying weight data -->
    <GridView
        android:id="@+id/gridViewWeight"
        android:layout_width="368dp"
        android:layout_height="590dp"
        android:layout_marginTop="8dp"
        android:horizontalSpacing="8dp"
        android:numColumns="2"
        android:paddingTop="20dp"
        android:verticalSpacing="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWeightByDate">

    </GridView>

</androidx.constraintlayout.widget.ConstraintLayout>